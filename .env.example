# Database
DATABASE_URL=postgresql://nba_props:nba_props@localhost:5432/nba_props

# NBA Stats (no key required, but rate-limited)
NBA_STATS_RATE_LIMIT_SEC=0.6

# Sportradar NBA API
SPORTRADAR_API_KEY=your_sportradar_api_key_here

# The Odds API
ODDS_API_KEY=your_odds_api_key_here

# API Server
API_HOST=0.0.0.0
API_PORT=8000

# Monte Carlo Settings
MONTE_CARLO_DRAWS=25000

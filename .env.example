# =============================================================================
# ValueHunter — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# Database (required)
DATABASE_URL=postgresql://nba_props:nba_props@localhost:5432/nba_props

# The Odds API (required — get a free key at https://the-odds-api.com/)
ODDS_API_KEY=

# Sportradar NBA API (optional — enables additional tracking data)
SPORTRADAR_API_KEY=

# NBA Stats rate limiting (no API key required, but rate-limited by NBA.com)
NBA_STATS_RATE_LIMIT_SEC=0.6

# API server
API_HOST=0.0.0.0
API_PORT=8000

# Monte Carlo simulation
MONTE_CARLO_DRAWS=25000
